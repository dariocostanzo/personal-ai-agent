APP_ENV=development
LOG_LEVEL=INFO
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# News source JSON objects: name, kind (rss/website/folder/newsletter), location.
# Sources can also be added and managed in the local dashboard.
NEWS_SOURCES=[]
NEWS_REFRESH_MINUTES=60
NEWS_FULL_REFRESH_HOURS=24
AGENT_SCHEDULER_ENABLED=true

# Optional local read-only calendar export.
AGENT_CALENDAR_ICS=data/calendar.ics

# Ollama is the default. Cloud providers are opt-in and receive prompt/context
# only when explicitly selected. Configure secrets only in your ignored .env.
AGENT_PROVIDER=ollama
AGENT_PROVIDER_CHAT=ollama
AGENT_MODEL_CHAT=
AGENT_PROVIDER_SELF_IMPROVEMENT=ollama
AGENT_MODEL_SELF_IMPROVEMENT=
AGENT_FALLBACK_PROVIDER=
AGENT_MODEL_CHAT_FALLBACK=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_INPUT_COST_PER_MILLION=
ANTHROPIC_OUTPUT_COST_PER_MILLION=

# Guardians monitor disk, directories, and Ollama; optional process names are
# comma-separated (Linux /proc). Additional service URLs can be reviewed in UI.
GUARDIAN_DISK_WARNING_PERCENT=90
GUARDIAN_PROCESSES=ollama
GUARDIAN_CHECK_MINUTES=15
